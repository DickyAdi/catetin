# Copy to apps/api/.env and fill in real values. Loaded by
# pydantic-settings (CATETIN_ env_prefix) — see src/catetin/config.py.

CATETIN_TELEGRAM_BOT_TOKEN=
CATETIN_TELEGRAM_WEBHOOK_SECRET=
CATETIN_OPS_USERNAME=
CATETIN_OPS_PASSWORD=

# Optional — defaults shown (see config.py for the full list)
# CATETIN_DATABASE_URL=sqlite+aiosqlite:///./catetin.db
# CATETIN_TIMEZONE=Asia/Jakarta
# CATETIN_LOG_LEVEL=INFO

# HTTP / webhook
# {secret} is substituted with CATETIN_TELEGRAM_WEBHOOK_SECRET at wiring time.
# CATETIN_WEBHOOK_PATH=/webhook/telegram/{secret}
# Max request body the ASGI shell will read, in bytes.
# CATETIN_BODY_MAX_BYTES=256000

# Database
# Reader pool size. The writer pool is fixed at 1: the pool IS the write lock.
# CATETIN_DB_READER_POOL_SIZE=3
# Revision the app asserts the DB is at during startup version_check. This is
# MANAGED BY MIGRATIONS: it is bumped in config.py alongside a new alembic
# revision. Do not set it in .env to silence a mismatch - run the migration.
# CATETIN_EXPECTED_DB_REVISION=0004_deletion_log

# Redis: not used in the MVP. Placeholder for RateLimiterPort only.
# Unset = no Redis.
# CATETIN_REDIS_URL=

# LLM gateway (Phase 2 placeholders, not on the hot path yet)
# Default points at the local 9router gateway.
# CATETIN_LLM_BASE_URL=http://localhost:20128/v1
# Unset = no auth header sent (fine for a local gateway).
# CATETIN_LLM_API_KEY=
# Monthly spend cap in rupiah. 0 = unlimited.
# CATETIN_LLM_MONTHLY_BUDGET_IDR=0

# PDF reports (/lapor)
# Per-user hourly cap on PDF generation.
# CATETIN_PDF_MAX_PER_USER_HOUR=5
# How many PDFs may render at once. Keep low: fpdf2 is CPU and RAM hungry and
# the host is 2 vCPU / 4 GB.
# CATETIN_PDF_CONCURRENCY=1

# Daily digest (scheduler)
# Whether new users get the digest by default.
# CATETIN_DIGEST_ENABLED_DEFAULT=true
# Hour of the day, in the user's local timezone, the digest is sent.
# CATETIN_DIGEST_HOUR_LOCAL=21

# Backups
# CATETIN_BACKUP_DIR=./backups
# How many nightly backups to retain before pruning the oldest.
# CATETIN_BACKUP_KEEP_N=7

# Observability
# Which ObservabilityPort adapter composition wires up:
#   null          : no-op, stays off the network entirely (default, tests/local)
#   stdout        : spans and metrics to the log
#   grafana_cloud : OTLP/HTTP to the Alloy collector
# Alloy holds the Grafana Cloud credentials (see
# infrastructure/deployment/.env.example); the app never sees them.
# CATETIN_OBSERVABILITY_BACKEND=null
# OTLP/HTTP endpoint, used only by the grafana_cloud backend.
# CATETIN_OTLP_ENDPOINT=http://alloy:4318

# age recipient for the nightly backup. This is a PUBLIC key: it can only
# encrypt, so keeping it here (and in the repo, if you like) is safe. Generate
# the pair OFF the server and keep identity.txt off the server forever:
#
#   age-keygen -o identity.txt     # prints "Public key: age1..." — that's this
#   age -d -i identity.txt -o catetin.db backups/catetin-<date>-<time>.db.age
#
# Unset = backups stay plaintext (the dev/test default).
# CATETIN_BACKUP_AGE_RECIPIENT=age1...
