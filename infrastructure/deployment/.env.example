# Copy to infrastructure/deployment/.env and fill in real values.
# NEVER commit the filled-in file (.gitignore already covers it).
#
# Where these come from: Grafana Cloud -> your stack -> "Details"/"Send data".
# Each signal shows its own push URL plus a numeric instance ID (the username).
# The token is ONE Access Policy token with logs:write + metrics:write +
# traces:write — create it under Access Policies, not a legacy API key.

# Numeric instance ID of the stack (same value for logs/metrics/OTLP).
GRAFANA_CLOUD_USER=

# Access Policy token (starts with glc_...). Treat as a password.
GRAFANA_CLOUD_TOKEN=

# Loki push endpoint — "Send Logs" panel.
GRAFANA_CLOUD_LOGS_URL=https://logs-prod-xxx.grafana.net/loki/api/v1/push

# Mimir/Prometheus remote-write endpoint — "Send Metrics" panel.
GRAFANA_CLOUD_METRICS_URL=https://prometheus-prod-xxx.grafana.net/api/prom/push

# Unified OTLP gateway — "OpenTelemetry" panel. No /v1/logs suffix here;
# Alloy appends the signal path itself.
GRAFANA_CLOUD_OTLP_URL=https://otlp-gateway-prod-xxx.grafana.net/otlp
