# Repo-root concerns only. App-specific ignores live in apps/api/.gitignore
# and apps/web/.gitignore (git resolves unrooted patterns relative to the
# .gitignore file's own directory, so this stays split cleanly per app).

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp

# Shared uv workspace virtualenv — one .venv for the whole workspace at repo
# root (apps/api is a member, not a standalone project — see CLAUDE.md).
.venv/

# Runtime DB backup output (apps/api config.py backup_dir, mounted at repo
# root via compose.yaml's catetin_data volume in dev/local runs)
backups/*
!backups/.gitkeep

# Dev-server pidfiles & logs (make dev-api/dev-fe/dev-all / dev-down)
.dev/

# Local scratch space: uploads, temp files, ad-hoc data dropped at repo root
uploads/
tmp/
*.tmp
